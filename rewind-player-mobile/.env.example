# .env.example — copy to .env and fill in your Cloudflare tunnel values
EXPO_PUBLIC_API_BASE_URL=https://your-tunnel.example.com/api/v1
EXPO_PUBLIC_KEYCLOAK_URL=https://your-tunnel.example.com
EXPO_PUBLIC_KEYCLOAK_REALM=your-realm
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=your-keycloak-client
EXPO_PUBLIC_MARKETPLACE_URL=https://your-marketplace.example.com